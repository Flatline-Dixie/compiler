cabal-version: 3.0
name: arithmetic-compiler
version: 0.1.0.0
synopsis: A small arithmetic expression compiler and stack-machine VM
description: Parses arithmetic expressions, compiles bytecode, and runs a stack VM.
category: Language
maintainer: Arithmetic Expression Compiler contributors
license: MIT
license-file: LICENSE
build-type: Simple

library
  exposed-modules: Arithmetic
  hs-source-dirs: src
  build-depends:
      base >=4.18 && <5
    , containers >=0.6 && <0.8
  default-language: Haskell2010
  ghc-options: -Wall

executable arithmetic-compiler
  main-is: main.hs
  hs-source-dirs: .
  build-depends:
      base >=4.18 && <5
    , arithmetic-compiler
  default-language: Haskell2010
  ghc-options: -Wall

test-suite arithmetic-compiler-test
  type: exitcode-stdio-1.0
  main-is: TestMain.hs
  hs-source-dirs: test
  build-depends:
      base >=4.18 && <5
    , arithmetic-compiler
    , QuickCheck >=2.14 && <3
  default-language: Haskell2010
  ghc-options: -Wall
